{
  "name": "growth-os",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node scripts/deploy-prepare.mjs && prisma generate && prisma db push --skip-generate --accept-data-loss && next build",
    "start": "next start -p 3000",
    "db:setup": "prisma migrate dev --name init --skip-seed",
    "db:push": "prisma db push",
    "smoke": "node scripts/smoke.mjs",
    "setup": "prisma migrate deploy && prisma generate && node scripts/seed.mjs",
    "clickbot": "node scripts/clickbot.mjs",
    "security": "node scripts/security.mjs",
    "features": "node scripts/features.mjs"
  },
  "dependencies": {
    "@prisma/client": "5.20.0",
    "bcryptjs": "2.4.3",
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.16.10",
    "@types/react": "18.3.10",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "prisma": "5.20.0",
    "tailwindcss": "3.4.13",
    "typescript": "5.6.2"
  }
}