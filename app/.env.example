# Copy to .env.local for local development. NEVER commit .env.local.
# Every integration below is OPTIONAL — without keys the platform still works
# (rule-based drafts, WhatsApp click-to-chat, manual billing).

# Required: SQLite file for dev, PostgreSQL URL in production
DATABASE_URL="file:./dev.db"

# Comma-separated emails that receive PLATFORM_ADMIN powers at signup
ADMIN_EMAILS="founder@example.com"

# Base URL of the deployment (used in invite emails and calendar exports)
APP_URL="http://localhost:3000"

# --- AI (optional) — any OpenAI-compatible API: OpenAI, OpenRouter, Groq... ---
# AI_API_KEY="sk-..."
# AI_BASE_URL="https://api.openai.com/v1"
# AI_MODEL="gpt-4o-mini"

# --- WhatsApp Cloud API (optional; click-to-chat links work without it) ---
# WHATSAPP_TOKEN="eaag..."
# WHATSAPP_PHONE_NUMBER_ID="123..."

# --- Transactional email via Resend (optional; invite links always shown in UI) ---
# RESEND_API_KEY="re_..."
# EMAIL_FROM="hello@yourdomain.com"

# --- Payments via Razorpay (optional; blocked link is logged as activity) ---
# RAZORPAY_KEY_ID="rzp_live_..."
# RAZORPAY_KEY_SECRET="..."
