# Copy to .env for local development. NEVER commit .env.
# SQLite for local dev; production uses Supabase Postgres (see README-APP.md):
DATABASE_URL="file:./dev.db"
# Emails (comma-separated) that get PLATFORM_ADMIN powers at signup:
ADMIN_EMAILS="founder@example.com"
# Port for smoke tests:
APP_URL="http://localhost:3000"
